// Prisma Schema for AI Customer Support Ticket Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  tickets            Ticket[]
  knowledgeDocuments KnowledgeDocument[]
  members            OrganizationMember[]
  chatbotMessages    ChatbotMessage[]
}

model User {
  id              String               @id @default(uuid())
  clerkUserId     String               @unique
  email           String
  name            String
  avatarUrl       String?
  role            String               @default("CUSTOMER") // "CUSTOMER" | "AGENT" | "ADMIN"
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTickets Ticket[]             @relation("AssignedAgent")
  createdTickets  Ticket[]             @relation("CustomerTickets")
  messages        Message[]
  events          TicketEvent[]
  feedback        CustomerFeedback[]
  memberships     OrganizationMember[]
  chatbotMessages ChatbotMessage[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       // "CUSTOMER" | "AGENT" | "ADMIN"
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Ticket {
  id              String            @id @default(uuid())
  ticketNumber    Int               @default(1000)
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User              @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgentId String?
  assignedAgent   User?             @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  subject         String
  description     String
  status          String            @default("OPEN") // "OPEN" | "IN_PROGRESS" | "WAITING_FOR_CUSTOMER" | "RESOLVED" | "CLOSED"
  priority        String            @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  category        String            @default("Other") // "Billing" | "Payments" | "Account" | "Technical Issue" | "Subscription" | "Refund" | "Security" | "Shipping" | "Product Question" | "Other"
  sentiment       String            @default("NEUTRAL") // "POSITIVE" | "NEUTRAL" | "FRUSTRATED" | "ANGRY"
  summary         String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        Message[]
  events          TicketEvent[]
  aiSuggestions   AiSuggestion[]
  attachments     Attachment[]
  feedback        CustomerFeedback?
}

model Message {
  id            String       @id @default(uuid())
  ticketId      String
  ticket        Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User         @relation(fields: [senderId], references: [id])
  senderType    String       // "CUSTOMER" | "AGENT" | "SYSTEM"
  content       String
  isAiGenerated Boolean      @default(false)
  createdAt     DateTime     @default(now())
  attachments   Attachment[]
}

model TicketEvent {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  eventType String   // e.g. "TICKET_CREATED", "TICKET_ASSIGNED", "PRIORITY_CHANGED", "STATUS_CHANGED", "AGENT_REPLIED", "AI_SUGGESTION_ACCEPTED"
  metadata  String?  // JSON serialized extra details
  createdAt DateTime @default(now())
}

model KnowledgeDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  fileContent    String
  version        String       @default("1.0")
  status         String       @default("INDEXED") // "INDEXED" | "PROCESSING" | "FAILED"
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AiSuggestion {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String   // "REPLY" | "SUMMARY" | "CLASSIFICATION" | "PRIORITY" | "SENTIMENT"
  content   String
  model     String   @default("gemini-2.5-flash")
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id])
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())
}

model CustomerFeedback {
  id        String   @id @default(uuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      // 1 to 5
  comment   String?
  createdAt DateTime @default(now())
}

model ChatbotMessage {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender         String       // "user" | "ai"
  text           String
  retrievedDocs  String?      // JSON serialized citations
  createdAt      DateTime     @default(now())
}
